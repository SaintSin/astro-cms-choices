---
// src/components/Analytics.astro
// Core Web Vitals tracking only
// Listens for Astro Page Load event
// 2026-10-17T00:00:00Z

const siteId = Astro.site ? new URL(Astro.site).hostname : "localhost";
---

<script define:vars={{ siteId }} is:inline>
  (function () {
    // Prevent multiple initializations during view transitions
    if (window.__astro_analytics_initialized) {
      return;
    }
    window.__astro_analytics_initialized = true;

    if (location.hostname === 'localhost' || location.hostname === '127.0.0.1') {
      return;
    }

    // Lighthouse/PageSpeed and other automation are not visitors
    if (navigator.webdriver || /headless/i.test(navigator.userAgent)) {
      return;
    }

    // Track active observers so we can disconnect them between navigations
    let activeObservers = [];

    function disconnectObservers() {
      activeObservers.forEach((obs) => obs.disconnect());
      activeObservers = [];
    }

    // Persistent cross-session identity — localStorage survives tab/browser
    // close, unlike the per-session sessionStorage id below, so repeat visits
    // from the same browser can be recognized as one visitor over time.
    function getOrCreateVisitorId() {
      let visitorId = localStorage.getItem('astro_cwv_visitor');
      if (!visitorId) {
        visitorId =
          'v_' + Date.now() + '_' + Math.random().toString(36).substring(2, 11);
        localStorage.setItem('astro_cwv_visitor', visitorId);
      }
      return visitorId;
    }

    function getUtmParams() {
      const params = new URLSearchParams(location.search);
      return {
        utm_source: params.get('utm_source') || null,
        utm_medium: params.get('utm_medium') || null,
        utm_campaign: params.get('utm_campaign') || null,
        utm_term: params.get('utm_term') || null,
        utm_content: params.get('utm_content') || null,
      };
    }

    function parseBrowser(ua) {
      if (!ua) return 'Unknown';
      const lower = ua.toLowerCase();
      if (lower.includes('edg/')) {
        const version = ua.match(/edg\/(\d+)/i);
        return `Edge ${version ? version[1] : ''}`;
      } else if (lower.includes('safari/') && !lower.includes('chrome')) {
        const version = ua.match(/version\/(\d+)/i);
        return `Safari ${version ? version[1] : ''}`;
      } else if (lower.includes('chrome/') && !lower.includes('edg')) {
        const version = ua.match(/chrome\/(\d+)/i);
        return `Chrome ${version ? version[1] : ''}`;
      } else if (lower.includes('firefox/')) {
        const version = ua.match(/firefox\/(\d+)/i);
        return `Firefox ${version ? version[1] : ''}`;
      }
      return 'Other';
    }

    // Sends the current page's metrics once; set by trackPageCWV()
    let flushCurrent = null;

    function trackPageCWV() {
      // Simple session management - one per browser session
      let sessionId = sessionStorage.getItem('astro_cwv_session');
      if (!sessionId) {
        sessionId =
          'cwv_' + Date.now() + '_' + Math.random().toString(36).substring(2, 11);
        sessionStorage.setItem('astro_cwv_session', sessionId);
      }

      const currentPath = location.pathname;

      // Per-page time-based deduplication (60 seconds)
      const now = Date.now();
      const lastSentKey = `cwv_sent_${currentPath}`;
      const lastSent = parseInt(sessionStorage.getItem(lastSentKey) || '0');
      const timeSinceLastSent = now - lastSent;
      const cooldown = 60000; // 60s

      if (timeSinceLastSent < cooldown) {
        return;
      }

      // Mark immediately so concurrent calls (astro:page-load fires on initial load with ClientRouter) are deduplicated
      sessionStorage.setItem(lastSentKey, now.toString());

      // Only after the dedupe check: a deduplicated call must not disconnect
      // the observers the first call is still using for final LCP/CLS/INP
      disconnectObservers();

      const browser = parseBrowser(navigator.userAgent);

      const metrics = {
        session_id: sessionId,
        visitor_id: getOrCreateVisitorId(),
        site_id: siteId,
        url: location.href,
        path: currentPath,
        referrer: document.referrer || null,
        user_agent: navigator.userAgent,
        browser: browser,
        timezone: Intl.DateTimeFormat().resolvedOptions().timeZone,
        screen_width: window.screen.width,
        screen_height: window.screen.height,
        lcp: null,
        cls: 0,
        fcp: null,
        ttfb: null,
        inp: null,
        duration_ms: 0,
        ...getUtmParams(),
      };

      // TTFB - only meaningful for actual navigation, not view transitions
      const navEntry = performance.getEntriesByType('navigation')[0];
      if (navEntry && navEntry.responseStart) {
        metrics.ttfb = navEntry.responseStart;
      }

      // LCP - always buffered for Astro
      try {
        const lcpObs = new PerformanceObserver((list) => {
          const entries = list.getEntries();
          const lastEntry = entries[entries.length - 1];
          if (lastEntry) {
            metrics.lcp =
              lastEntry.renderTime || lastEntry.loadTime || lastEntry.startTime;
          }
        });
        lcpObs.observe({ type: 'largest-contentful-paint', buffered: true });
        activeObservers.push(lcpObs);
      } catch (e) {}

      // FCP - always buffered for Astro
      try {
        const fcpObs = new PerformanceObserver((list) => {
          for (const entry of list.getEntries()) {
            if (entry.name === 'first-contentful-paint') {
              metrics.fcp = entry.startTime;
            }
          }
        });
        fcpObs.observe({ type: 'paint', buffered: true });
        activeObservers.push(fcpObs);
      } catch (e) {}

      // CLS - use buffered for cumulative score
      try {
        const clsObs = new PerformanceObserver((list) => {
          for (const entry of list.getEntries()) {
            if (!entry.hadRecentInput && entry.value !== undefined) {
              metrics.cls += entry.value;
            }
          }
        });
        clsObs.observe({ type: 'layout-shift', buffered: true });
        activeObservers.push(clsObs);
      } catch (e) {}

      // INP - Interaction to Next Paint
      try {
        const inpObs = new PerformanceObserver((list) => {
          let maxDelay = 0;
          for (const entry of list.getEntries()) {
            if (entry.interactionId && entry.duration) {
              maxDelay = Math.max(maxDelay, entry.duration);
            }
          }
          if (maxDelay > 0) {
            metrics.inp = Math.max(maxDelay, metrics.inp || 0);
          }
        });
        inpObs.observe({ type: 'event', buffered: true, durationThreshold: 0 });
        activeObservers.push(inpObs);
      } catch (e) {}

      // Send metrics function
      let sent = false;
      function sendMetrics() {
        if (sent) return;
        sent = true;

        // Calculate time spent on this page
        metrics.duration_ms = Date.now() - now;

        // Disconnect observers before sending final values
        disconnectObservers();

        const blob = new Blob([JSON.stringify(metrics)], {
          type: 'application/json',
        });

        if (navigator.sendBeacon) {
          navigator.sendBeacon('/.netlify/functions/pandalytics', blob);
        } else {
          fetch('/.netlify/functions/pandalytics', {
            method: 'POST',
            body: JSON.stringify(metrics),
            headers: { 'Content-Type': 'application/json' },
            keepalive: true,
          }).catch(() => {});
        }
      }

      flushCurrent = sendMetrics;
    }

    // Send once per page when it is hidden/closed or when a ClientRouter
    // navigation replaces it, so LCP/CLS/INP are final and quick exits are
    // counted (sendBeacon survives unload). Soft navigations never fire
    // pagehide/visibilitychange, hence astro:before-swap.
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden' && flushCurrent) flushCurrent();
    });
    addEventListener('pagehide', () => {
      if (flushCurrent) flushCurrent();
    });
    document.addEventListener('astro:before-swap', () => {
      if (flushCurrent) flushCurrent();
    });

    // Idle so the observer setup never counts toward Total Blocking Time
    // (the observers are buffered, so nothing is missed).
    function schedule() {
      if ('requestIdleCallback' in window) {
        requestIdleCallback(trackPageCWV, { timeout: 3000 });
      } else {
        setTimeout(trackPageCWV, 200);
      }
    }

    // Initial load, then every ClientRouter navigation. astro:page-load also
    // fires on the initial load; the 60s dedupe in trackPageCWV() absorbs it.
    if (document.readyState === 'complete') schedule();
    else addEventListener('load', schedule, { once: true });
    document.addEventListener('astro:page-load', schedule);
  })();
</script>
