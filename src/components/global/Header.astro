---
// @components/global/Header.astro

import Nav from "@components/global/HeaderNav.astro";
---

<header class="header">
  <div class="wrapper header-inner">
    <a href="/" class="site-name">
      Astro Showcase<span class="site-name-extra"> · What CMS? · How Fast?</span>
    </a>
    <Nav />
  </div>
</header>
<style>
  /* One source of truth for the header's height: the mobile menu drops down from it,
     and a fixed height means a late web-font swap can't re-wrap the header and push
     the page down (it used to wrap to a variable number of lines on phones). */
  :global(:root) {
    --header-height: calc(2.75rem + 2 * var(--space-xs));
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 1000;
    margin-block-end: var(--space-l);
    background: var(--color-gradient);
    color: oklch(100% 0 0 / 92%);
    padding-block: var(--space-xs);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-m);
    min-block-size: 2.75rem;
  }

  .site-name {
    font-family: var(--font-heading-alt);
    font-weight: 600;
    font-size: var(--step-0);
    text-decoration: none;
    color: inherit;
    white-space: nowrap;
  }

  /* Show the short name until there is room for the full one beside five inline links
     (the full name needs ~860px); the full name stays in the accessible text. */
  @media (width < 960px) {
    .site-name-extra {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  @media (forced-colors: active) {
    .header {
      border-block: 1px solid CanvasText;
    }
  }
</style>
