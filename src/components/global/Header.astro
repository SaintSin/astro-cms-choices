---
// @components/global/Header.astro

import Nav from "@components/global/HeaderNav.astro";
---

<header class="header">
  <div class="wrapper header-inner">
    <a href="/" class="site-name">Astro Showcase · What CMS? · How Fast?</a>
    <Nav />
  </div>
</header>
<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 1000;
    margin-block-end: var(--space-l);
    background: var(--color-gradient);
    color: oklch(100% 0 0 / 92%);
    padding-block: var(--space-xs);
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-m);
  }

  .site-name {
    font-family: var(--font-heading-alt);
    font-weight: 600;
    font-size: var(--step-0);
    text-decoration: none;
    color: inherit;
  }

  @media (forced-colors: active) {
    .header {
      border-block: 1px solid CanvasText;
    }
  }
</style>
