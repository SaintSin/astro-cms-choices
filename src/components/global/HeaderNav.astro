---
// @components/global/HeaderNav.astro

// Not using a list, as Google sites don't seem to use it. And being sheep we follow Google

import { siteMetadata } from "@config/siteMetadata";

const { pathname } = Astro.url;
const links = siteMetadata.menu ?? [];
---

<nav class="nav-links">
  {
    links.map((link) => (
      <a
        class={pathname == link.href ? "active--exact" : ""}
        href={link.href}
        data-astro-prefetch
      >
        {link.label}
      </a>
    ))
  }
</nav>

<style>
  .nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-s);
    font-size: var(--step--1);

    a {
      color: oklch(100% 0 0 / 70%);
      text-decoration: none;

      &:hover {
        color: oklch(100% 0 0);
      }
    }

    .active--exact {
      color: oklch(100% 0 0);
      font-weight: 700;
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 4px;
    }
  }
</style>
