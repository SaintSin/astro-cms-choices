---
// src/pages/notes/index.astro

import { getCollection } from "astro:content";
import Layout from "@layouts/BaseLayout.astro";

const meta = {
	title: "Notes — Astro Showcase | What CMS? How Fast?",
	description: "Findings and write-ups from scanning the Astro showcase.",
};

const fmt = (d: Date) =>
	d.toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric" });

// Newest activity first: a recently updated note rises above newer-published ones.
const latest = (n: { data: { date: Date; updated?: Date } }) =>
	(n.data.updated ?? n.data.date).valueOf();
const notes = (await getCollection("notes")).sort((a, b) => latest(b) - latest(a));
---

<Layout metaData={meta}>
  <main class="wrapper flow notes-index">
    <h1>Notes</h1>
    <ul>
      {notes.map((note) => (
        <li>
          <a href={`/notes/${note.id}/`}>{note.data.title}</a>
          <p>{note.data.description}</p>
          <p class="note-dates">
            Published <time datetime={note.data.date.toISOString()}>{fmt(note.data.date)}</time>
            {note.data.updated && (
              <>
                · Updated <time datetime={note.data.updated.toISOString()}>{fmt(note.data.updated)}</time>
              </>
            )}
          </p>
        </li>
      ))}
    </ul>
  </main>
</Layout>

<style>
  .notes-index ul { list-style: none; padding: 0; }
  .notes-index li { margin-block-end: var(--space-l); }
  .notes-index .note-dates { color: var(--color-mid); font-size: var(--step--1); }
</style>
