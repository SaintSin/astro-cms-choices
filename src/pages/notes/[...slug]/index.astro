---
// src/pages/notes/[...slug]/index.astro

import { getCollection, render } from "astro:content";
import Layout from "@layouts/BaseLayout.astro";

export async function getStaticPaths() {
	const notes = await getCollection("notes");
	return notes.map((note) => ({
		params: { slug: note.id },
		props: { note },
	}));
}

const { note } = Astro.props;
const { Content } = await render(note);
const fmt = (d: Date) =>
	d.toLocaleDateString("en-GB", {
		year: "numeric",
		month: "long",
		day: "numeric",
	});

const meta = {
	title: `${note.data.title} — Astro Showcase | What CMS? How Fast?`,
	description: note.data.description,
	...(note.data.ogImage
		? { imageOG: note.data.ogImage, altOG: note.data.title }
		: {}),
};
---

<Layout metaData={meta}>
  <main class="wrapper">
    <article class="note flow">
      <h1>{note.data.title}</h1>
      <p class="note-dates">
        Published <time datetime={note.data.date.toISOString()}>{fmt(note.data.date)}</time>
        {note.data.updated && (
          <>
            · Updated <time datetime={note.data.updated.toISOString()}>{fmt(note.data.updated)}</time>
          </>
        )}
      </p>
      <Content />
    </article>
  </main>
</Layout>

<style>
  .note {
    max-width: 70ch;
  }
  .note-dates { color: var(--color-mid); margin-block-end: var(--space-m); }
  .note :global(table) { width: 100%; border-collapse: collapse; margin-block: var(--space-m); }
  .note :global(th), .note :global(td) { border: 1px solid var(--color-keyline); padding: 0.5em 0.75em; text-align: left; }
</style>
