---
// src/pages/themes.astro
// 2026-10-28T00:00:00Z

import ShowcasePagination from "@components/showcase/ShowcasePagination.astro";
import ThemeRow from "@components/showcase/ThemeRow.astro";
import Layout from "@layouts/BaseLayout.astro";
import { loadThemes } from "../utils/themesData";

const meta = {
	title: "Astro Themes — PageSpeed Insight Scores",
	description:
		"Every theme in the Astro themes catalogue: free or paid, when it was added, the Astro version its demo runs on, and PageSpeed Insights Lighthouse scores for the demo.",
	imageOG: "og-themes.png",
	altOG: "Astro themes — free vs paid and Lighthouse scores",
};

const PAGE_SIZE = 50;
const {
	themes,
	generatedAt,
	freeCount,
	paidCount,
	testedCount,
	astroCount,
	freeMobileAvg,
	paidMobileAvg,
	freeDesktopAvg,
	paidDesktopAvg,
} = loadThemes();
const cmsOptions = [
	...new Set(themes.flatMap((t) => (t.cms ? t.cms.split(",") : []))),
].sort((a, b) => a.localeCompare(b));
---

<Layout metaData={meta}>
  <main class="wrapper flow">
    <header class="page-header flow">
      <h1>Astro Themes <span class="muted">PageSpeed Insights</span></h1>
      <p class="page-lead">
        Themes from the <a href="https://astro.build/themes/" target="_blank" rel="noopener noreferrer">Astro themes catalogue</a>,
        with the Astro version each <strong>demo</strong> runs on and its
        PageSpeed Insights Lighthouse scores, the best of three or more runs.{" "}
        {generatedAt && <>Scored {new Date(generatedAt).toLocaleDateString("en-GB", { dateStyle: "medium" })}. </>}
        A demo should be a theme at its best: it shows how a theme can perform, not how your site will.
        Scores: <span class="legend good">≥ 90</span> <span class="legend mid">50–89</span> <span class="legend poor">&lt; 50</span>
      </p>
    </header>

    <div class="stats-row">
      <div class="stat-card"><span class="stat-value">{themes.length.toLocaleString()}</span><span class="stat-label">Themes</span></div>
      <div class="stat-card"><span class="stat-value">{freeCount.toLocaleString()}</span><span class="stat-label">Free</span></div>
      <div class="stat-card"><span class="stat-value">{paidCount.toLocaleString()}</span><span class="stat-label">Paid</span></div>
      <div class="stat-card"><span class="stat-value">{astroCount.toLocaleString()}</span><span class="stat-label">Demo runs Astro</span></div>
      <div class="stat-card"><span class="stat-value">{testedCount.toLocaleString()}</span><span class="stat-label">Scored</span></div>
      <div class="stat-card"><span class="stat-value">{freeMobileAvg ?? "—"}</span><span class="stat-label">Free, mobile perf avg</span></div>
      <div class="stat-card"><span class="stat-value">{paidMobileAvg ?? "—"}</span><span class="stat-label">Paid, mobile perf avg</span></div>
      <div class="stat-card"><span class="stat-value">{freeDesktopAvg ?? "—"}</span><span class="stat-label">Free, desktop perf avg</span></div>
      <div class="stat-card"><span class="stat-value">{paidDesktopAvg ?? "—"}</span><span class="stat-label">Paid, desktop perf avg</span></div>
    </div>

    <ul class="table-notes">
      <li>
        <strong>Astro</strong> is the version the <em>demo</em> is running on, read from the demo's own page. Some
        themes are listed as an "Astro 7 theme" but their demos run an earlier version. A dash means the demo doesn't
        publish its version.
      </li>
      <li>
        <strong>CMS</strong> names are declared by the theme developer in the theme's catalogue listing. We haven't
        checked them, and a theme with no CMS shown may still work with one.
      </li>
    </ul>

    <div class="toolbar">
      <input type="search" id="themes-search" class="search-input" placeholder="Filter by theme, author or CMS…" autocomplete="off" />
      <label class="check"><input type="checkbox" id="themes-free" checked /> Free</label>
      <label class="check"><input type="checkbox" id="themes-paid" checked /> Paid</label>
      <select id="themes-cms" class="cms-select" aria-label="CMS">
        <option value="">Any CMS</option>
        {cmsOptions.map((c) => <option value={c.toLowerCase()}>{c}</option>)}
      </select>
      <span class="result-count" id="result-count">{themes.length} themes</span>
    </div>

    <div class="table-wrap" id="themes-table-wrap">
      <table class="themes-table data-table" id="themes-table">
        <colgroup>
          <col class="col-theme" /><col class="col-price" /><col class="col-added" /><col class="col-ver" />
          <col class="col-score" /><col class="col-score" /><col class="col-score" /><col class="col-score" /><col class="col-agentic" />
          <col class="col-score" /><col class="col-score" /><col class="col-score" /><col class="col-score" /><col class="col-agentic" />
          <col class="col-total" />
        </colgroup>
        <thead>
          <tr>
            <th class="sortable col-theme" data-col="title">Theme</th>
            <th class="sortable col-price" data-col="paid">Price</th>
            <th class="sortable col-added" data-col="added">Added</th>
            <th class="sortable col-ver" data-col="version" title="The Astro version the demo is running on, not necessarily the version the theme is listed for">Astro</th>
            <th class="col-group-header" colspan="5">Mobile</th>
            <th class="col-group-header" colspan="5">Desktop</th>
            <th class="col-group-header col-group-total">/ 800</th>
          </tr>
          <tr class="subheader">
            <th></th><th></th><th></th><th></th>
            <th class="sortable metric-th" data-col="m_perf">Perf</th>
            <th class="sortable metric-th" data-col="m_a11y">A11y</th>
            <th class="sortable metric-th" data-col="m_bp">BP</th>
            <th class="sortable metric-th" data-col="m_seo">SEO</th>
            <th class="sortable metric-th" data-col="m_agentic" title="Agentic Browsing — audits passed / applicable">Agt</th>
            <th class="sortable metric-th" data-col="d_perf">Perf</th>
            <th class="sortable metric-th" data-col="d_a11y">A11y</th>
            <th class="sortable metric-th" data-col="d_bp">BP</th>
            <th class="sortable metric-th" data-col="d_seo">SEO</th>
            <th class="sortable metric-th" data-col="d_agentic" title="Agentic Browsing — audits passed / applicable">Agt</th>
            <th class="sortable metric-th" data-col="total_800">/ 800</th>
          </tr>
        </thead>
        <tbody id="themes-tbody">
          {themes.map((t, i) => <ThemeRow t={t} hidden={i >= PAGE_SIZE} />)}
        </tbody>
      </table>
    </div>

    <ShowcasePagination id="themes-pagination" />
  </main>
</Layout>

<style>
  /* Fixed layout would squash 15 columns on a phone; scroll instead. Every column
     but Theme is sized to its content (padding included); Theme takes the rest. */
  .themes-table { min-inline-size: 75rem; }
  .col-price, .col-ver { width: 4.5rem; }
  .col-added { width: 5.75rem; }
  .col-score, .col-total { width: 4.25rem; }
  .col-agentic { width: 3.75rem; }
  .col-group-total { font-weight: 700; }
  .metric-th { text-align: right; }
  /* Customizable select where supported (Chromium, Safari 27+); other browsers
     keep the native dropdown. */
  @supports (appearance: base-select) {
    .cms-select,
    .cms-select::picker(select) {
      appearance: base-select;
    }
    .cms-select {
      inline-size: 12rem;
      padding: var(--space-2xs) var(--space-xs);
      border: 1px solid var(--color-keyline);
      border-radius: var(--space-3xs);
      background: var(--color-light);
      color: var(--color-text);
      font-size: var(--step--1);
      cursor: pointer;
    }
    .cms-select:is(:hover, :open) { border-color: var(--color-keyline-strong); }
    .cms-select:focus-visible {
      outline: 2px solid var(--color-primary);
      outline-offset: 2px;
    }
    .cms-select::picker-icon {
      color: var(--color-text-subtle);
      transition: rotate 0.2s;
    }
    .cms-select:open::picker-icon { rotate: 180deg; }
    .cms-select::picker(select) {
      margin-block: var(--space-3xs);
      padding: var(--space-3xs);
      max-block-size: 24rem;
      border: 1px solid var(--color-keyline);
      border-radius: var(--space-3xs);
      background: var(--color-light);
      box-shadow: 0 8px 24px oklch(20% 0.02 265 / 0.14);
      opacity: 0;
      transform: translateY(-0.25rem);
      transition: opacity 0.15s, transform 0.15s, overlay 0.15s allow-discrete,
        display 0.15s allow-discrete;
    }
    .cms-select:open::picker(select) {
      opacity: 1;
      transform: none;
    }
    @starting-style {
      .cms-select:open::picker(select) {
        opacity: 0;
        transform: translateY(-0.25rem);
      }
    }
    .cms-select option {
      padding: var(--space-3xs) var(--space-xs);
      border-radius: var(--space-3xs);
      font-size: var(--step--1);
      cursor: pointer;
    }
    .cms-select option:is(:hover, :focus-visible) { background: var(--color-surface); }
    .cms-select option:checked { font-weight: 600; }
    .cms-select option::checkmark { color: var(--color-success); }
  }
  .table-notes {
    margin: 0;
    padding-inline-start: var(--space-s);
    font-size: var(--step--1);
    color: var(--color-mid);
    max-inline-size: 80ch;
  }
  .check { display: inline-flex; align-items: center; gap: 0.4ch; }
  .check input { accent-color: var(--color-success); }
  /* Cells live in ThemeRow, so reach them with :global. Tighter side padding
     keeps the whole table on screen. */
  .themes-table :global(:is(td, th)) { padding-inline: var(--space-2xs); }
  /* Mobile group starts at col 5, desktop at col 10, total at col 15 */
  .themes-table :global(:is(td, th):is(:nth-child(5), :nth-child(10), :nth-child(15))) {
    border-inline-start: 2px solid var(--color-keyline);
  }
</style>

<script is:inline>
  (() => {
    const PAGE_SIZE = 50;
    const tbody = document.getElementById("themes-tbody");
    const searchEl = document.getElementById("themes-search");
    const freeEl = document.getElementById("themes-free");
    const paidEl = document.getElementById("themes-paid");
    const cmsEl = document.getElementById("themes-cms");
    const countEl = document.getElementById("result-count");
    const tableWrap = document.getElementById("themes-table-wrap");
    const paginationEl = document.getElementById("themes-pagination");
    if (!tbody) return;

    const allRows = Array.from(tbody.querySelectorAll("tr"));
    let filtered = allRows.slice();
    let page = 1;
    let sortCol = null;
    let sortDir = "asc";

    function applyView() {
      const start = (page - 1) * PAGE_SIZE;
      allRows.forEach((r) => r.setAttribute("data-hidden", ""));
      filtered.slice(start, start + PAGE_SIZE).forEach((r) => r.removeAttribute("data-hidden"));
      if (countEl) countEl.textContent = `${filtered.length} themes`;
      renderPagination(paginationEl, filtered.length, page, PAGE_SIZE, (p) => {
        page = p;
        applyView();
        tableWrap?.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    }

    function sortRows() {
      if (!sortCol) return;
      const text = ["title", "paid", "added", "version"].includes(sortCol);
      filtered.sort((a, b) => {
        const av = a.dataset[sortCol] ?? "";
        const bv = b.dataset[sortCol] ?? "";
        if (av === "" && bv === "") return 0;
        if (av === "") return 1;
        if (bv === "") return -1;
        const c = text ? av.localeCompare(bv, undefined, { numeric: true }) : parseFloat(av) - parseFloat(bv);
        return sortDir === "asc" ? c : -c;
      });
      filtered.forEach((r) => tbody.appendChild(r));
    }

    function applyFilters() {
      const q = searchEl.value.trim().toLowerCase();
      filtered = allRows.filter(
        (r) =>
          (!q || r.dataset.title.includes(q) || r.dataset.author.includes(q) || r.dataset.cms.includes(q)) &&
          (r.dataset.paid === "paid" ? paidEl.checked : freeEl.checked) &&
          (!cmsEl.value || r.dataset.cms.split(",").includes(cmsEl.value)),
      );
      sortRows();
      page = 1;
      applyView();
    }

    [searchEl, freeEl, paidEl, cmsEl].forEach((el) => el?.addEventListener("input", applyFilters));

    document.querySelectorAll(".themes-table .sortable").forEach((th) => {
      th.addEventListener("click", () => {
        const col = th.dataset.col;
        if (sortCol === col) sortDir = sortDir === "asc" ? "desc" : "asc";
        else {
          sortCol = col;
          sortDir = ["title", "paid", "version"].includes(col) ? "asc" : "desc";
        }
        document.querySelectorAll(".themes-table .sortable").forEach((h) => h.classList.remove("sort-asc", "sort-desc"));
        th.classList.add(sortDir === "asc" ? "sort-asc" : "sort-desc");
        sortRows();
        page = 1;
        applyView();
      });
    });

    applyView();
  })();
</script>
