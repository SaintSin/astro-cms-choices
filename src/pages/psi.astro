---
// src/pages/psi.astro
// 2026-06-11T00:00:00Z

import PsiRow from "@components/showcase/PsiRow.astro";
import ShowcasePagination from "@components/showcase/ShowcasePagination.astro";
import Layout from "@layouts/BaseLayout.astro";
import { loadPsi } from "../utils/psiData";

const meta = {
	title: "Lighthouse Scores — Astro Showcase | What CMS? How Fast?",
	description:
		"PageSpeed Insights Lighthouse scores — performance, accessibility, best practices, SEO, and Agentic Browsing — for confirmed Astro showcase sites on mobile and desktop.",
	imageOG: "og-psi.png",
	altOG:
		"Lighthouse Scores — PageSpeed Insights results for confirmed Astro sites",
};

const PAGE_SIZE = 50;
const {
	sites,
	generatedAt,
	mobileCount,
	desktopCount,
	mobilePerfHigh,
	desktopPerfHigh,
	perfect800,
	high800,
} = loadPsi();

if (mobileCount > 0) {
	meta.altOG = `Lighthouse Scores — ${mobileCount.toLocaleString()} mobile tested, ${mobilePerfHigh.toLocaleString()} mobile perf ≥90, ${desktopPerfHigh.toLocaleString()} desktop perf ≥90`;
}
---

<Layout metaData={meta}>
  <main class="wrapper flow">
    <header class="page-header flow">
      <h1>Lighthouse Scores <span class="muted">PageSpeed Insights</span></h1>
      <p class="page-lead">
        <a href="https://developer.chrome.com/docs/lighthouse/overview/" target="_blank" rel="noopener noreferrer">Lighthouse</a> scores
        for confirmed Astro sites via the PageSpeed Insights API — mobile and desktop strategies, including the new &nbsp;
        <a href="https://developer.chrome.com/docs/lighthouse/agentic-browsing/scoring" target="_blank" rel="noopener noreferrer">Agentic Browsing</a> category.
        Data collected {new Date(generatedAt).toLocaleDateString("en-GB", { dateStyle: "medium" })}.
        Scores: <span class="legend good">≥ 90</span> <span class="legend mid">50–89</span> <span class="legend poor">&lt; 50</span>
      </p>
    </header>

    <div class="stats-row">
      <div class="stat-card">
        <span class="stat-value">{mobileCount.toLocaleString()}</span>
        <span class="stat-label">Mobile</span>
      </div>
      <div class="stat-card">
        <span class="stat-value">{desktopCount.toLocaleString()}</span>
        <span class="stat-label">Desktop</span>
      </div>
      <div class="stat-card stat-card--pass">
        <span class="stat-value">{mobilePerfHigh.toLocaleString()}</span>
        <span class="stat-label">Mobile perf ≥ 90</span>
      </div>
      <div class="stat-card stat-card--pass">
        <span class="stat-value">{desktopPerfHigh.toLocaleString()}</span>
        <span class="stat-label">Desktop perf ≥ 90</span>
      </div>
      <div class="stat-card stat-card--pass">
        <span class="stat-value">{high800.toLocaleString()}</span>
        <span class="stat-label">Score ≥ 720 / 800</span>
      </div>
      <div class="stat-card stat-card--pass">
        <span class="stat-value">{perfect800.toLocaleString()}</span>
        <span class="stat-label">Perfect 800 / 800</span>
      </div>
    </div>

    <div class="toolbar">
      <input
        type="search"
        id="psi-search"
        class="search-input"
        placeholder="Filter by site name or URL…"
        autocomplete="off"
      />
      <span class="result-count" id="result-count">{sites.length} sites</span>
    </div>

    <div class="table-wrap" id="psi-table-wrap">
      <table class="psi-table data-table" id="psi-table" data-total={sites.length}>
        <colgroup>
          <col class="col-site" />
          <col class="col-ver" />
          <col class="col-perf" /><col class="col-a11y" /><col class="col-bp" /><col class="col-seo" /><col class="col-total" /><col class="col-agentic" />
          <col class="col-perf" /><col class="col-a11y" /><col class="col-bp" /><col class="col-seo" /><col class="col-total" /><col class="col-agentic" />
          <col class="col-total800" />
        </colgroup>
        <thead>
          <tr>
            <th class="sortable col-site" data-col="title">Site</th>
            <th class="sortable col-ver" data-col="version">Astro</th>
            <th class="col-group-header" colspan="6">Mobile</th>
            <th class="col-group-header" colspan="6">Desktop</th>
            <th class="col-group-header col-group-total">/ 800</th>
          </tr>
          <tr class="subheader">
            <th></th>
            <th></th>
            <th class="sortable metric-th col-perf"    data-col="m_perf">Perf</th>
            <th class="sortable metric-th col-a11y"    data-col="m_a11y">A11y</th>
            <th class="sortable metric-th col-bp"      data-col="m_bp">BP</th>
            <th class="sortable metric-th col-seo"     data-col="m_seo">SEO</th>
            <th class="sortable metric-th col-total"   data-col="m_total">/ 400</th>
            <th class="sortable metric-th col-agentic" data-col="m_agentic" title="Agentic Browsing — audits passed / applicable">Agentic</th>
            <th class="sortable metric-th col-perf"    data-col="d_perf">Perf</th>
            <th class="sortable metric-th col-a11y"    data-col="d_a11y">A11y</th>
            <th class="sortable metric-th col-bp"      data-col="d_bp">BP</th>
            <th class="sortable metric-th col-seo"     data-col="d_seo">SEO</th>
            <th class="sortable metric-th col-total"   data-col="d_total">/ 400</th>
            <th class="sortable metric-th col-agentic" data-col="d_agentic" title="Agentic Browsing — audits passed / applicable">Agentic</th>
            <th class="sortable metric-th col-total800" data-col="total_800">/ 800</th>
          </tr>
        </thead>
        <tbody id="psi-tbody">
          {sites.slice(0, PAGE_SIZE).map((s) => <PsiRow s={s} />)}
        </tbody>
      </table>
    </div>

    <ShowcasePagination id="psi-pagination" />
  </main>
</Layout>

<style>

  
  /* ── Table ─────────────────────────────────────────────────── */

  .col-site  { width: 28ch; }
  .col-ver   { width: 7ch; }
  .col-perf, .col-a11y, .col-bp, .col-seo { width: 6ch; }
  .col-agentic { width: 9ch; } /* fits "Agentic ⇅" sort control */
  .col-total { width: 6ch; }
  .col-total800 { width: 6ch; }

  .col-group-header { width: 39ch; /* 4 × 6ch + 6ch total + 9ch agentic */ }

  .col-group-total {
    width: 8ch;
    font-weight: 700;
  }

  .metric-th { text-align: right; }

  /* Group dividers — desktop starts at col 9, /800 at col 15 */
  .psi-table td:nth-child(9),
  .psi-table th:nth-child(9),
  .psi-table td:nth-child(15),
  .psi-table th:nth-child(15) {
    border-inline-start: 2px solid var(--color-keyline);
  }

</style>

<script is:inline>
  function initPsi() {
    const tbody    = document.getElementById("psi-tbody");
    const searchEl = document.getElementById("psi-search");
    const countEl  = document.getElementById("result-count");
    const tableWrap = document.getElementById("psi-table-wrap");
    const paginationEl = document.getElementById("psi-pagination");

    if (!tbody) return;

    const TOTAL = parseInt(document.getElementById("psi-table")?.dataset.total ?? "0", 10);
    // Page 1 is in the HTML; the rest comes from /psi-rows/ when idle or on
    // first interaction. Sorting, searching and paging wait for it.
    let allRows = Array.from(tbody.querySelectorAll("tr"));
    let filtered = allRows.slice();
    let currentPage = 1;
    const PAGE_SIZE = 50;
    let loaded = false;
    let loading = null;

    function loadRows() {
      // Dev serves /psi-rows/; the static build writes an extension-less file.
      loading ??= fetch("/psi-rows/")
        .then((r) => (r.ok ? r : fetch("/psi-rows")))
        .then((r) => {
          if (!r.ok) throw new Error(String(r.status));
          return r.text();
        })
        .then((html) => {
          const t = document.createElement("template");
          t.innerHTML = html;
          const rows = Array.from(t.content.querySelectorAll("tr"));
          rows.forEach((r) => r.setAttribute("data-hidden", ""));
          tbody.append(...rows);
          allRows = [...allRows, ...rows];
          filtered = allRows.slice();
          loaded = true;
        })
        .catch(() => { loading = null; });
      return loading;
    }

    // Run fn now if all rows are present, otherwise after they arrive.
    function whenLoaded(fn) {
      if (loaded) return fn();
      if (countEl) countEl.textContent = "Loading sites…";
      return loadRows().then(() => { if (loaded) fn(); });
    }

    let sortCol = null;
    let sortDir = "asc";

    function applyView() {
      const start = (currentPage - 1) * PAGE_SIZE;
      const end   = start + PAGE_SIZE;
      allRows.forEach((r) => r.setAttribute("data-hidden", ""));
      filtered.slice(start, end).forEach((r) => r.removeAttribute("data-hidden"));
      const count = loaded ? filtered.length : TOTAL;
      if (countEl) countEl.textContent = `${count} sites`;
      renderPagination(paginationEl, count, currentPage, PAGE_SIZE, (p) => whenLoaded(() => {
        currentPage = p;
        applyView();
        tableWrap?.scrollIntoView({ behavior: "smooth", block: "start" });
      }));
    }

    // Search
    if (searchEl) {
      searchEl.addEventListener("input", () => whenLoaded(() => {
        const q = searchEl.value.trim().toLowerCase();
        filtered = q
          ? allRows.filter(
              (r) =>
                r.dataset.title?.includes(q) || r.dataset.url?.includes(q),
            )
          : allRows.slice();
        if (sortCol) doSort(false);
        currentPage = 1;
        applyView();
      }));
    }

    // Sort
    function numVal(r, col) {
      const v = r.dataset[col];
      return v === "" || v === undefined ? null : parseFloat(v);
    }

    function strVal(r, col) {
      return r.dataset[col] ?? "";
    }

    function doSort(resetPage = true) {
      const col = sortCol;
      filtered.sort((a, b) => {
        let av, bv;
        if (col === "title") {
          av = strVal(a, "title"); bv = strVal(b, "title");
          return sortDir === "asc"
            ? av.localeCompare(bv)
            : bv.localeCompare(av);
        }
        if (col === "version") {
          av = strVal(a, "version"); bv = strVal(b, "version");
          if (!av && !bv) return 0;
          if (!av) return 1;
          if (!bv) return -1;
          return sortDir === "asc"
            ? av.localeCompare(bv, undefined, { numeric: true })
            : bv.localeCompare(av, undefined, { numeric: true });
        }
        // Numeric score columns
        av = numVal(a, col); bv = numVal(b, col);
        if (av === null && bv === null) return 0;
        if (av === null) return 1;
        if (bv === null) return -1;
        return sortDir === "asc" ? av - bv : bv - av;
      });
      // Re-order rows in DOM
      filtered.forEach((r) => tbody.appendChild(r));
      if (resetPage) currentPage = 1;
      applyView();
    }

    document.querySelectorAll(".psi-table .sortable").forEach((th) => {
      th.addEventListener("click", () => whenLoaded(() => {
        const col = th.dataset.col;
        if (sortCol === col) {
          sortDir = sortDir === "asc" ? "desc" : "asc";
        } else {
          sortCol = col;
          sortDir = col === "title" || col === "version" ? "asc" : "desc";
        }
        document.querySelectorAll(".psi-table .sortable").forEach((h) => {
          h.classList.remove("sort-asc", "sort-desc");
        });
        th.classList.add(sortDir === "asc" ? "sort-asc" : "sort-desc");
        doSort();
      }));
    });

    applyView();

    // Fetch the remaining rows once the page has settled, or sooner if the
    // user reaches for the table.
    ["pointerenter", "focusin", "touchstart"].forEach((ev) =>
      document.querySelector(".toolbar")?.addEventListener(ev, loadRows, { once: true, passive: true })
    );
    tableWrap?.addEventListener("pointerenter", loadRows, { once: true, passive: true });
    const idleLoad = () => setTimeout(() => (window.requestIdleCallback ?? setTimeout)(loadRows), 3000);
    if (document.readyState === "complete") idleLoad();
    else window.addEventListener("load", idleLoad, { once: true });
  }

  initPsi();
</script>
