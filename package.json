{
	"name": "astro60",
	"version": "0.0.1",
	"author": "St John Mackay",
	"contributors": [
		{
			"name": "Claude (Anthropic)",
			"url": "https://claude.ai"
		}
	],
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"format": "biome format --write .",
		"lint": "biome lint --write .",
		"check": "biome check --write .",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"detect": "node --experimental-strip-types scripts/detect-cms.ts",
		"db:init": "node --experimental-strip-types scripts/db-init.ts",
		"db:report": "node --experimental-strip-types scripts/db-report.ts",
		"psi": "node scripts/psi.mjs",
		"crux": "node scripts/crux.mjs",
		"dns-check": "node scripts/dns-check.mjs",
		"make-prs": "node scripts/make-removal-prs.mjs",
		"generate:og-cards": "node scripts/generate-og-cards.mjs",
		"clean": "rm -rf dist .astro",
		"purge": "rm -rf dist .astro .netlify node_modules",
		"deploy": "netlify deploy --prod --dir dist --functions netlify/functions",
		"deploy:draft": "netlify deploy --dir dist --functions netlify/functions"
	},
	"dependencies": {
		"@astrojs/compiler-rs": "^0.4.0",
		"@astrojs/mdx": "^7.0.7",
		"@astrojs/sitemap": "^3.7.3",
		"@felixicaza/astro-capo": "^1.2.1",
		"@iconify-json/ri": "^1.2.10",
		"astro": "^7.2.4",
		"astro-iconify": "^1.3.1",
		"astro-llms-md": "^3.0.1",
		"astro-robots-txt": "^1.0.0",
		"chart.js": "^4.5.1",
		"i": "^0.3.7",
		"open-props": "^1.7.23",
		"sharp": "^0.35.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@netlify/functions": "^6.0.0",
		"@types/better-sqlite3": "^9.6.0",
		"better-sqlite3": "^13.0.3",
		"oxfmt": "^0.64.0",
		"playwright": "^1.62.1",
		"postcss-jit-props": "^1.0.16"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af"
}
