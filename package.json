{
	"name": "astro60",
	"version": "0.0.1",
	"author": "St John Mackay",
	"contributors": [
		{
			"name": "Claude (Anthropic)",
			"url": "https://claude.ai"
		}
	],
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"format": "biome format --write .",
		"lint": "biome lint --write .",
		"check": "biome check --write .",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"test": "node --experimental-strip-types --no-warnings --test scripts/__tests__/*.test.*",
		"detect": "node --experimental-strip-types scripts/detect-cms.ts",
		"db:init": "node --experimental-strip-types scripts/db-init.ts",
		"db:report": "node --experimental-strip-types scripts/db-report.ts",
		"psi": "node scripts/psi.mjs",
		"themes": "node --experimental-strip-types --no-warnings scripts/themes.ts",
		"crux": "node scripts/crux.mjs",
		"dns-check": "node scripts/dns-check.mjs",
		"make-prs": "node scripts/make-removal-prs.mjs",
		"recheck-blocked": "node --experimental-strip-types scripts/recheck-blocked.ts",
		"merge-recheck": "node --experimental-strip-types scripts/merge-recheck-results.ts",
		"generate:og-cards": "node scripts/generate-og-cards.mjs",
		"clean": "rm -rf dist .astro",
		"purge": "rm -rf dist .astro .netlify node_modules",
		"deploy": "netlify deploy --prod --dir dist --functions netlify/functions",
		"deploy:draft": "netlify deploy --dir dist --functions netlify/functions"
	},
	"dependencies": {
		"@astrojs/compiler-rs": "^0.5.2",
		"@astrojs/mdx": "^8.1.2",
		"@astrojs/sitemap": "^3.7.4",
		"@felixicaza/astro-capo": "^1.2.2",
		"@iconify-json/ri": "^1.2.10",
		"astro": "^7.4.4",
		"astro-iconify": "^1.3.1",
		"astro-llms-md": "^3.0.2",
		"astro-robots-txt": "^1.0.0",
		"chart.js": "^4.6.1",
		"i": "^0.3.7",
		"open-props": "^1.7.23",
		"sharp": "^0.35.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@netlify/functions": "^6.0.3",
		"@types/better-sqlite3": "^9.6.0",
		"better-sqlite3": "^13.0.3",
		"oxfmt": "^0.75.0",
		"playwright": "^1.64.1",
		"postcss-jit-props": "^1.0.16"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9"
}
